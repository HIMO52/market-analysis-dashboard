# --- Python ---
__pycache__/
*.pyc
*.pyo
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/

# --- 環境変数・秘密情報 ---
.env
*.local

# --- データベース・生成データ ---
# 【重要】GitHub Actionsは毎回まっさらな環境で実行されるため、
# 株価・ニュースのデータを引き継ぐには、DBファイル自体をリポジトリに
# コミットする必要がある。そのため意図的に除外しない（Phase 12/13）。
data/raw/*
!data/raw/.gitkeep

# --- Webサイト生成物（Actionsが毎回作るので基本コミット不要） ---
docs/data/*.json
docs/data/*.json.gz

# --- OS ---
.DS_Store
Thumbs.db

# --- エディタ ---
.vscode/
.idea/
